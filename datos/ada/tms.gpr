project TMS is

   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("tms_main.adb", "test_track_store.adb", "test_alarms.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnaty3abcefhiklmnprt");
   end Compiler;

end TMS;
